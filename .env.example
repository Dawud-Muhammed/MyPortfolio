# Browser-safe Supabase project URL and anonymous/publishable key. NEVER put a secret in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SITE_URL=https://dawud-muhammed.vercel.app

# Server ONLY (Vercel environment settings). Use separate projects/keys for staging.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SITE_URL=https://dawud-muhammed.vercel.app
OPENAI_API_KEY=your-server-only-openai-project-key
ASSISTANT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Both this switch AND CMS assistant_settings.enabled must be true for paid requests.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=gpt-6-luna
# Verify account model access and current Standard pricing before setting this reviewed date.
ASSISTANT_PRICING_VERIFIED=
ASSISTANT_DAILY_USD=0.50
ASSISTANT_MONTHLY_USD=5
ASSISTANT_TOTAL_USD=10
