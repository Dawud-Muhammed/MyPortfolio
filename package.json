{
  "name": "dawud-systems-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "dev:api": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "format:check": "prettier --check src/App.tsx src/studio.css src/components/PortfolioGuide.tsx src/components/GitHubContributionGraph.tsx src/lib/github-contributions.ts",
    "dev:public": "vite --mode public-preview --host 127.0.0.1 --port 5175 --strictPort"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.344.0",
    "openai": "^7.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
